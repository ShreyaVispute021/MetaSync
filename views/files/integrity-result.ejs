
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Integrity Verification | MetaSync</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet">
  <style>
  body {
    background-color: #212529;
    color: #f8f9fa;
  }

  h2, p, strong, label {
    color: #f8f9fa;
  }

  .text-secondary {
    color: #ced4da !important;
  }

  .card {
    background-color: #000 !important;
    color: #f8f9fa !important;
  }

  code, .text-info {
    color: #5ee7ff !important;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .alert-success {
    background-color: #123d2a;
    color: #d1fae5;
    border-color: #198754;
  }

  .alert-danger {
    background-color: #4a1d23;
    color: #ffe3e6;
    border-color: #dc3545;
  }
</style>
</head>
<body class="bg-dark text-light">
  <nav class="navbar navbar-dark bg-black px-4">
    <a class="navbar-brand fw-bold" href="/files/dashboard">MetaSync</a>
  </nav>

  <main class="container py-5">
    <div class="card bg-black border-secondary">
      <div class="card-body p-4">
        <h2>File Integrity Verification</h2>
        <p class="text-secondary">
          File: <strong class="text-light"><%= file.name %></strong>
        </p>

        <% if (integrityStatus === "PASS") { %>
          <div class="alert alert-success">
            Integrity verified. The physical file matches both recorded SHA-256 checksums.
          </div>
        <% } else { %>
          <div class="alert alert-danger">
            Verification result: <strong><%= integrityStatus %></strong>
          </div>
          <p>
            The file could not be fully verified. Check the storage file and
            metadata before relying on it.
          </p>
        <% } %>

        <p><strong>Status:</strong> <%= integrityStatus %></p>
        <p><strong>Version:</strong> <%= version ? "V" + version.versionNo : "Unavailable" %></p>
        <p><strong>Replica state:</strong> <%= replica ? replica.state : "Unavailable" %></p>

        <hr class="border-secondary">

        <p><strong>Expected SHA-256</strong></p>
        <code class="text-info text-break"><%= version ? version.checksum : "Unavailable" %></code>

        <p class="mt-3"><strong>Actual SHA-256</strong></p>
        <code class="text-info text-break"><%= actualChecksum || "Unavailable" %></code>

        <div class="mt-4">
          <a href="/files/dashboard" class="btn btn-primary">
            Back to Dashboard
          </a>
        </div>
      </div>
    </div>
  </main>
</body>
</html>
