<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard | MetaSync</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-dark text-light">
  <nav class="navbar navbar-dark bg-black border-bottom border-secondary px-4">
    <a class="navbar-brand fw-bold" href="/files/dashboard">MetaSync</a>
    <a class="btn btn-outline-light btn-sm" href="/files/recycle-bin">
      Recycle Bin
    </a>    
    <a class="btn btn-outline-info btn-sm" href="/files/duplicates">
      Find Duplicates
    </a>
    <a class="btn btn-outline-info btn-sm" href="/files/storage-monitor">
      Storage Monitor
    </a>    
    <a class="btn btn-outline-warning btn-sm" href="/files/audit-logs/export">
      Export Audit CSV
    </a>
    <div class="d-flex align-items-center gap-3">
      <span>Hello, <%= userName %></span>
      <form action="/auth/logout" method="POST">
        <button class="btn btn-outline-light btn-sm">Logout</button>
      </form>
    </div>
  </nav>

  <main class="container py-5">
    <div class="mb-4">
      <h1 class="fw-bold">Distributed File Dashboard</h1>
      <p class="text-secondary">
        Actual files are stored on simulated nodes; MongoDB controls metadata, versions, replicas, operation state, and audit history.
      </p>
    </div>

    <% if (message) { %>
      <div class="alert alert-success"><%= message %></div>
    <% } %>

    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <div class="row g-4 mb-4">
      <% nodes.forEach(node => { %>
        <div class="col-md-4">
          <div class="card bg-black border-secondary text-light h-100">
            <div class="card-body">
              <h5><%= node.nodeName %></h5>
              <p class="mb-1">Status: <span class="text-success"><%= node.status %></span></p>
              <p class="mb-0">Used: <%= (node.usedSpaceBytes / 1024).toFixed(2) %> KB</p>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <div class="card bg-black border-secondary text-light mb-4">
      <div class="card-body p-4">
        <h4 class="mb-3">Upload a File</h4>

        <form action="/files/upload" method="POST" enctype="multipart/form-data">
          <div class="row g-3 align-items-end">
            <div class="col-md-5">
              <label class="form-label">Select File</label>
              <input class="form-control" type="file" name="file" required>
            </div>

            <div class="col-md-4">
              <label class="form-label">Storage Node</label>
              <select class="form-select" name="nodeId" required>
                <% nodes.forEach(node => { %>
                  <option value="<%= node._id %>"><%= node.nodeName %></option>
                <% }) %>
              </select>
            </div>

            <div class="col-md-3">
              <button class="btn btn-primary w-100">Upload and Register Metadata</button>
            </div>
          </div>
        </form>
      </div>
    </div>

    <div class="card bg-black border-secondary text-light">
      <div class="card-body p-4">
          <form action="/files/dashboard" method="GET" class="row g-2 mb-4">
            <div class="col-md-5">
              <input
                class="form-control"
                type="search"
                name="q"
                placeholder="Search filename..."
                value="<%= q %>"
              >
            </div>

            <div class="col-md-2">
              <input
                class="form-control"
                type="text"
                name="ext"
                placeholder="Extension (pdf)"
                value="<%= ext %>"
              >
            </div>

            <div class="col-md-3">
              <select class="form-select" name="sort">
                <option value="newest" <%= sort === "newest" ? "selected" : "" %>>
                  Recently updated
                </option>
                <option value="oldest" <%= sort === "oldest" ? "selected" : "" %>>
                  Oldest updated
                </option>
                <option value="nameAsc" <%= sort === "nameAsc" ? "selected" : "" %>>
                  Name A–Z
                </option>
                <option value="nameDesc" <%= sort === "nameDesc" ? "selected" : "" %>>
                  Name Z–A
                </option>
              </select>
            </div>

            <div class="col-md-2 d-flex gap-2">
              <button class="btn btn-primary" type="submit">Apply</button>
              <a class="btn btn-outline-light" href="/files/dashboard">Reset</a>
            </div>
          </form>

          <p class="text-secondary">
            Matching files: <%= totalFiles %>
          </p>

        <h4 class="mb-3">My Active Files</h4>

        <% if (files.length === 0) { %>
          <p class="text-secondary mb-0">
            No matching files found. Try changing your search or filters.
          </p>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
              <thead>
                <tr>
                  <th>File</th>
                  <th>Version</th>
                  <th>Size</th>
                  <th>Checksum</th>
                  <th>Revision</th>
                  <th>Action</th>
                  <th>Tags</th>
                </tr>
              </thead>
              <tbody>
                <% files.forEach(file => { %>
                  <tr>
                    <td><%= file.name %></td>
                    <td>V<%= file.currentVersionId?.versionNo || 1 %></td>
                    <td><%= file.currentVersionId ? (file.currentVersionId.size / 1024).toFixed(2) : 0 %> KB</td>
                    <td><code class="text-info"><%= file.currentVersionId?.checksum?.slice(0, 16) || "N/A" %>...</code></td>
                    <td><%= file.revision %></td>
                    <td class="d-flex gap-2">
                        <a class="btn btn-sm btn-success" href="/files/<%= file._id %>/download">
                            Download
                        </a>
                        <a class="btn btn-sm btn-primary" href="/files/<%= file._id %>/versions">
                            Versions
                        </a>         
                        <form action="/files/<%= file._id %>/delete" method="POST" onsubmit="return confirm('Move this file to the recycle bin?');">
                          <button class="btn btn-sm btn-danger" type="submit">
                            Delete
                          </button>
                        </form>                        
                        <a class="btn btn-sm btn-info"
                          href="/files/<%= file._id %>/verify">
                          Verify
                        </a>
                    </td>                    
                    <td style="min-width: 190px;">
                      <form
                        action="/files/<%= file._id %>/tags"
                        method="POST"
                        class="d-flex flex-column gap-2"
                      >
                        <input
                          class="form-control form-control-sm"
                          type="text"
                          name="tags"
                          value="<%= (file.tags || []).join(', ') %>"
                          placeholder="Documents, Projects"
                          maxlength="310"
                        >

                        <button class="btn btn-sm btn-outline-info align-self-start" type="submit">
                          Save Tags
                        </button>
                      </form>

                      <small class="text-secondary d-block mt-1">
                        Tags: <%= (file.tags || []).join(", ") || "None" %>
                      </small>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
        
        <% if (totalPages > 1) { %>
          <nav class="mt-4" aria-label="File pages">
            <ul class="pagination pagination-sm mb-0">
              <% if (page > 1) { %>
                <li class="page-item">
                  <a class="page-link"
                     href="/files/dashboard?q=<%= encodeURIComponent(q) %>&ext=<%= encodeURIComponent(ext) %>&sort=<%= sort %>&page=<%= page - 1 %>">
                    Previous
                  </a>
                </li>
              <% } %>

              <li class="page-item disabled">
                <span class="page-link">
                  Page <%= page %> of <%= totalPages %>
                </span>
              </li>

              <% if (page < totalPages) { %>
                <li class="page-item">
                  <a class="page-link"
                     href="/files/dashboard?q=<%= encodeURIComponent(q) %>&ext=<%= encodeURIComponent(ext) %>&sort=<%= sort %>&page=<%= page + 1 %>">
                    Next
                  </a>
                </li>
              <% } %>
            </ul>
          </nav>
        <% } %>

      </div>
    </div>
  </main>
</body>
</html>